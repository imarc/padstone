{% import "/_macros" as macros %}

{% extends "/_blocks/baseSection" %}

{% block content %}

<div class="logoGrid">
    {% for icon in block.logos.all() %}
        <div class="logoGrid__item">
            {{ macros.responsiveImage(icon, { pictureClass: 'logoGrid__img' }) }}
        </div>
    {% endfor %}
</div>

{% endblock %}
