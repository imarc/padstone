{% import "/_macros" as macros %}

{% extends "/_blocks/baseSection" %}

{% block content %}
    <div class="section__content">
        <div class="grid -columns-3">
            {% for card in block.cards.eagerly().all() %}
                {# Cards linked to an entry fall back to that entry's title, featured image and abstract. #}
                {% set ctaLink = card.ctaLink %}
                {% set linked = ctaLink and ctaLink.type == 'entry' ? ctaLink.element : null %}
                {% set linkedImage = linked.featuredImage ?? null %}
                {% set cardData = {
                    title: card.title ?: (linked.title ?? null),
                    image: card.image.eagerly().one() ?: (linkedImage ? linkedImage.one() : null),
                    content: card.blockContent|length ? card.blockContent : (linked.abstract ?? null)
                } %}
                <div class="cell">
                    <div class="card" style="max-width: 25.75rem;">
                        <div class="card__content">
                            <span class="card__title h3">
                                {{ cardData.title }}
                            </span>
                            <p class="card__description">
                                {{ cardData.content }}
                            </p>
                            {% if ctaLink %}
                                <a href="{{ ctaLink }}" class="card__cta link -wide">
                                    {{ ctaLink.label }}
                                    <svg class="card__ctaIcon link__icon">
                                        <use href="/main-icons-sprite.svg#arrow-right" />
                                    </svg>
                                </a>
                            {% endif %}
                        </div>
                        {% if cardData.image %}
                            <div class="card__imageWrapper">
                                {{ macros.responsiveImage(cardData.image, { pictureClass: 'card__image' }) }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
