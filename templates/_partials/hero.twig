{% import "/_macros" as macros %}

{% if hero is defined and hero is instance of('craft\\elements\\db\\MatrixBlockQuery') %}
    {% if hero.count > 0 %}
        {% set hero = hero.one %}
    {% else %}
        {% set hero = false %}
    {% endif %}
{% endif %}

{% if hero is defined and hero %}
    {# set falsy defaults to simplify null checks #}
    {% set hero = {
        backgroundImage: null,
        heroEyebrow: null,
        heroHeadline: null,
        heroSubheadline: null,
        heroIntroduction: null,
        CTA: null
    }|merge(hero) %}

    <section class="section container hero {{ hero.backgroundImage|length ? 'accent-primary' : '' }}">
        <div class="hero__content">
            <div class="hero__text">
                {% if hero.heroEyebrow %}
                    <div class="eyebrow accent-primary">{{ hero.heroEyebrow }}</div>
                {% endif %}
                {% if hero.heroHeadline %}
                    <h1 class="hero__heading">{{ hero.heroHeadline }}</h1>
                  {% else %} 
                    <h1 class="hero__heading">{{ entry.title }}</h1>
                {% endif %}
                {% if hero.heroIntroduction %}
                    <p class="hero__introduction">
                        {{ hero.heroIntroduction }}
                    </p>
                {% endif %}
                {% if hero.ctaLink is defined and hero.ctaLink|length %}
                    <div class="actions">
                        {{ macros.renderLink (hero.ctaLink, { class: 'button' })}}
                    </div>
                {% endif %}
            </div>
            {# FOR KERRI - IMAGE FIELD UPDATE #}
            {% if hero.backgroundImage|length %}
                <div class="hero__image">
                    {{ macros.responsiveImage(hero.backgroundImage.one, { pictureClass: 'hero__asset' }) }}
                </div>
            {% endif %}
        </div>
    </section>

{% else %}
    <section class="section container hero accent-primary">
        <div class="hero__content">
            <header class="section__header">
                <h1 class="section__heading">{{ entry.title }}</h1>
            </header>
        </div>
    </section>
{% endif %}
